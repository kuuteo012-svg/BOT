# ============================================================
# HI88 Browser Bot — production environment
# Never commit or share this file publicly. Keep permissions at 600.
# Replace the credential placeholders before starting the bot.
# ============================================================

# Telegram credentials
API_ID=
API_HASH=
SESSION_NAME=session_3bao_bot

# Optional Telegram Bot API alert settings
ALERT_BOT_TOKEN=8823390594:AAHrpqTMIXRlW-u3g5nahjFrNQKT2GnrBDo
TELEGRAM_ADMIN_ID=8279295717
ALERT_CHAT_ID=8279295717
SUBMIT_SUCCESS_NOTIFY=false
SUBMIT_SUCCESS_CHAT_ID=8279295717
ALERT_HTTP_TIMEOUT=10.0

# Telegram connection and startup
TELEGRAM_AUTO_RECONNECT=false
TELEGRAM_CONNECTION_RETRIES=0
TELEGRAM_MAX_RECONNECT_ATTEMPTS=5
TELEGRAM_CONNECT_TIMEOUT=20.0
TELEGRAM_REQUEST_TIMEOUT=20.0
TELEGRAM_HEARTBEAT_TIMEOUT=8.0
TELEGRAM_CHANNEL_TIMEOUT=10.0
TELEGRAM_CATCH_UP=false
TELEGRAM_FAST_RAM_INGRESS=false
TELEGRAM_FILTER_AT_SOURCE=true
TELEGRAM_INGRESS_CLOCK_SKEW_SECONDS=30
TELEGRAM_LOG_ALL_INGRESS=false
TELEGRAM_SYNC_DIALOGS=false
# ✅ FIX [mất tin khi bot restart]: live_only trước đây khiến init_systems()
# gọi discard_unfinished() và XOÁ mọi row 'pending'/'processing' còn dang dở
# từ phiên chạy trước (vd bot bị restart/crash giữa lúc đang OCR/submit) —
# tin nhắn đó coi như bị bỏ vĩnh viễn dù đã được nhận vào DurableInbox.
# at_least_once dùng reclaim_stale() thay vào đó: chỉ đưa row 'processing'
# bị kẹt về lại 'pending' để xử lý tiếp, không xoá. Đánh đổi: có thể replay
# một vài code đã hết hạn sau khi restart — vô hại vì submit sẽ tự fail,
# và domain_code_worker/db.is_code_used() đã chặn submit trùng theo domain.
TELEGRAM_INBOX_RECOVERY_MODE=at_least_once
TELEGRAM_INBOX_ENQUEUE_RETRIES=3
TELEGRAM_INBOX_SQLITE_DEFERRED_RETRIES=3
TELEGRAM_INBOX_SQLITE_DEFERRED_RETRY_DELAY=2.0

# Optional channel ID overrides, comma-separated
# Leave empty to use CHANNEL_CONFIG defaults from config.py.
HI88_CHAT_IDS=
QQ88_CHAT_IDS=

# Durable inbox
TELEGRAM_INBOX_DB_PATH=data/telegram_inbox.db
TELEGRAM_INBOX_LEASE_SECONDS=300
TELEGRAM_INBOX_DRAIN_BATCH=250
TELEGRAM_INBOX_DRAIN_INTERVAL=0.10
MAX_INBOX_ATTEMPTS=5
INBOX_RETRY_BASE_DELAY=2.0
INBOX_RETRY_MAX_DELAY=120.0
INBOX_MAX_PENDING_AGE_SECONDS=900.0
INBOX_PENDING_SWEEP_INTERVAL_SECONDS=300.0

# Browser / Edge CDP
EDGE_CDP_HOST=127.0.0.1
EDGE_CDP_PORT=9222
EDGE_EXECUTABLE_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
EDGE_PROFILE_DIR=
EDGE_PROFILE_NAME=Default
AUTO_OPEN_MISSING_TABS=true
PAGE_NAVIGATION_TIMEOUT=15000
CDP_PING_INTERVAL=60.0
EDGE_CDP_WATCHDOG_INTERVAL=5.0

# Browser concurrency
MAX_CONCURRENT_SUBMITS=8
MAX_CONCURRENT_SUBMITS_PER_DOMAIN=2
MULTI_SITE_MAX_CONCURRENT_DOMAINS=4
SINGLE_SITE_MAX_CONCURRENT_DOMAINS=2
TAB_POOL_SIZE=2
MAX_TAB_PER_DOMAIN_CAP=3
TAB_POOL_MIN_TABS_PER_DOMAIN=2
TAB_ACQUIRE_WAIT_SECONDS=5.0

# Account and submit safety
ACCOUNTS_PER_CODE=2
PRESERVE_PREFILLED_USERNAME=true
MAX_RETRIES_PER_ACCOUNT=2
RETRY_ON_TIMEOUT=true

# Domain rate limiting
REQUESTS_PER_MINUTE=30
MAX_BURST=5
RATE_LIMIT_BACKOFF_SECONDS=5.0
MAX_RATE_LIMIT_RETRIES=5
MIN_DELAY_BETWEEN_SUBMITS=0.0

# Browser circuit breaker
BROWSER_CIRCUIT_FAILURE_THRESHOLD=3
BROWSER_CIRCUIT_COOLDOWN_SECONDS=60.0

# Form, verification, and result timing
FORM_SETTLE_SECONDS=0.03
MM88_FORM_SETTLE_SECONDS=0.05
CF_WAIT_SECONDS=1.0
CF_POLL_INTERVAL=0.05
VERIFICATION_BUTTON_WAIT_SECONDS=15.0
GG88_TURNSTILE_WAIT_SECONDS=15.0
HI88_VERIFICATION_WAIT_SECONDS=15.0
QQ88_VERIFICATION_WAIT_SECONDS=20.0
RESULT_DETECTION_TIMEOUT=7000
RESULT_POLL_INTERVAL=0.05
RESULT_SELECTOR_FAST_WINDOW_SECONDS=0.80
QQ88_RESULT_DETECTION_TIMEOUT=3500
HI88_RESULT_DETECTION_TIMEOUT=4500
RR88_RESULT_DETECTION_TIMEOUT=3000
XX88_RESULT_DETECTION_TIMEOUT=3500
GG88_RESULT_DETECTION_TIMEOUT=3500
O8_RESULT_DETECTION_TIMEOUT=3000
MM88_RESULT_DETECTION_TIMEOUT=4000
# ❌ Đã xoá SUBMIT_TIMEOUT_SECONDS — biến này KHÔNG được config.py hay bất
# kỳ file .py nào đọc (đã grep toàn bộ codebase để xác nhận), nên set nó
# không có tác dụng gì. Timeout submit thực tế do *_RESULT_DETECTION_TIMEOUT
# theo từng site (ở trên) và các timeout hardcode trong browser_engine.py
# quyết định. Nếu bạn có set SUBMIT_TIMEOUT_SECONDS trong .env thật (không
# phải file mẫu này), xoá nó đi để tránh nhầm tưởng đang tune đúng chỗ.

# Queue and workers
MESSAGE_WORKERS=4
MAX_CONCURRENT_PROCESSING=24
MAX_CONCURRENT_INGRESS_TASKS=64
MESSAGE_QUEUE_MAXSIZE=2000
DOMAIN_QUEUE_MAXSIZE=500
SHUTDOWN_MESSAGE_DRAIN_TIMEOUT=8.0

# OCR and media
MAX_CONCURRENT_OCR=2
MAX_CONCURRENT_MEDIA_DOWNLOADS=2
MAX_CONCURRENT_MEDIA_PIPELINES=3
MEDIA_PIPELINE_QUEUE_MAXSIZE=200
VIDEO_OCR_MAX_FRAMES=2
MAX_OCR_CODES_PER_BATCH=4
OCR_FAST_PATH=true
OCR_FAST_MIN_CHARS=8
OCR_FAST_VARIANTS=1
OCR_PREPROCESS_FALLBACK=true
OCR_PREPROCESS_MODE=otsu
QQ88_OCR_REQUIRE_MARKER=true
OCR_MAX_IMAGE_SIDE=1024
OCR_MIN_CROP_WIDTH=300
OCR_CONFIDENCE_THRESHOLD=0.70
OCR_DEBUG_SAVE_FRAMES=false
MEDIA_CLEANUP_INTERVAL_SECONDS=86400
OCR_TEMP_DIR_MAX_AGE_SECONDS=86400
OCR_ALLOWED_CHANNEL_IDS=
OCR_MEDIA_ONLY_CHANNEL_IDS=
OCR_MEDIA_FALLBACK_CHANNEL_IDS=
OCR_FALLBACK_ALL_MEDIA=false
# Có thể tắt OCR theo nhóm site nhưng vẫn xử lý spoiler/caption/text:
# Khuyến nghị: để trống và dùng "ocr_enabled": false riêng từng channel
# HI88/QQ88 trong Config.CHANNEL_CONFIG. Group override tùy chọn:
# OCR_DISABLED_FILTER_GROUPS=hi88,qq88
OCR_DISABLED_FILTER_GROUPS=
# Tắt riêng từng channel bằng "ocr_enabled": false trong config.py.
# ocr_video_enabled=false chỉ tắt video, không tắt OCR ảnh.
MEDIA_DOWNLOAD_RETRIES=1
MEDIA_DOWNLOAD_RETRY_DELAY=0.5
MEDIA_DOWNLOAD_MAX_SIZE_MB=200
FAST_TELEGRAM_DOWNLOAD=false
FAST_DOWNLOAD_MIN_BYTES=4194304
FAST_DOWNLOAD_WORKERS=8
FAST_DOWNLOAD_CHUNK_KB=512
FAST_DOWNLOAD_MAX_CONNECTIONS=8
PAUSE_OCR_ON_HIGH_CPU=true
OCR_CPU_THRESHOLD=85
OCR_RAM_WARN_THRESHOLD=85
OCR_RAM_PAUSE_THRESHOLD=90

# Logging and storage
ENABLE_DASHBOARD=true
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=WARNING
LOG_FILE=logs/bot_activity.log
LOG_DIR=logs
DATABASE_PATH=data/code_history.db
SESSION_AUTO_BACKUP=true
SESSION_DELETE_AFTER_BACKUP=false
SESSION_BACKUP_DIR=backups/sessions
LOG_USE_UTC=false
LOG_ROTATION_MAX_BYTES=10485760
LOG_ROTATION_BACKUP_COUNT=7
LOG_RETENTION_DAYS=7
CONSOLE_COLOR=true
DEBUG_VERBOSE_MODE=false

# Health monitoring
HEALTH_CHECK_INTERVAL=30.0
HEALTH_BREACH_CONFIRM_COUNT=2
HEARTBEAT_INTERVAL=300.0

# Queue pressure controls
QUEUE_CHECK_INTERVAL=5.0
QUEUE_SOFT_LIMIT_PCT=0.75
QUEUE_HARD_LIMIT_PCT=0.95
QUEUE_CLEANUP_ON_SOFT_LIMIT=false
QUEUE_CLEANUP_TARGET_PCT=0.50

# Miscellaneous defaults
SITE_CODE_DEDUP_TTL=30.0
FULL_RELOAD_EVERY_N=100
SCREENSHOT_ON_UNKNOWN=true
INPUT_CACHE_CLEANUP_INTERVAL=30.0
